{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": "admin",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] }
    ]
  }
}
