<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#30FF2BD6"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E02A0838" android:endColor="#E00E0016"/>
            <stroke android:width="1.5dp" android:color="#FFFF4FD8"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
