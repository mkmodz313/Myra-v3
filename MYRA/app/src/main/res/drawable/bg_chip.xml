<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFFF4FD8" android:endColor="#FFB01E9E"/>
            <stroke android:width="1dp" android:color="#FFFFE0FA"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80200030"/>
            <stroke android:width="1dp" android:color="#AAFF5BE0"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
