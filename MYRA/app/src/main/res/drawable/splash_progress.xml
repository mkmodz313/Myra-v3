<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#CC12001A"/>
            <stroke android:width="2dp" android:color="#FFFF6BE6"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#FFB01E9E" android:centerColor="#FFFF4FD8" android:endColor="#FFFFE0FA"/>
                <corners android:radius="8dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
