<?xml version="1.0" encoding="utf-8"?>
<!--
  MYRA home screen — neon-pink futuristic companion layout (9:16 composition, fully constraint based).
  The original layout is preserved untouched as activity_main_legacy.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neon_bg">

    <!-- Scene: night garden, cherry blossoms, pavilion, lotus pond -->
    <ImageView
        android:id="@+id/sceneBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/myra_bg_scene"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Readability scrim behind the header -->
    <View
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_top_scrim"
        android:rotation="180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Petals, stars, butterflies -->
    <com.myra.assistant.ui.avatar.AmbientFxView
        android:id="@+id/ambientFx"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ═════════════ HEADER ═════════════ -->
    <ImageView
        android:id="@+id/crownTop"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.3"
        android:text="MYRA"
        android:textColor="@color/neon_pink"
        android:textSize="30sp"
        android:shadowColor="#FFFF2BD6"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crownTop"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_neon_line"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toStartOf="@id/titleText"
        app:layout_constraintStart_toEndOf="@id/batteryBlock"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintVertical_bias="0.55"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_neon_line_r"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toStartOf="@id/clockBlock"
        app:layout_constraintStart_toEndOf="@id/titleText"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintVertical_bias="0.55"/>

    <TextView
        android:id="@+id/taglineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.3"
        android:text="@string/app_tagline"
        android:textColor="@color/neon_white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText"/>

    <View
        android:layout_width="36dp"
        android:layout_height="1dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_neon_line"
        app:layout_constraintBottom_toBottomOf="@id/taglineText"
        app:layout_constraintEnd_toStartOf="@id/taglineText"
        app:layout_constraintTop_toTopOf="@id/taglineText"/>

    <View
        android:layout_width="36dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_neon_line_r"
        app:layout_constraintBottom_toBottomOf="@id/taglineText"
        app:layout_constraintStart_toEndOf="@id/taglineText"
        app:layout_constraintTop_toTopOf="@id/taglineText"/>

    <!-- Battery + RAM -->
    <LinearLayout
        android:id="@+id/batteryBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_battery"
            android:drawablePadding="4dp"
            android:drawableTint="@color/neon_white"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="100%"
            android:textColor="@color/neon_pink"
            android:textSize="15sp"
            android:shadowColor="#FFFF2BD6"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"/>

        <TextView
            android:id="@+id/ramText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="--MB"
            android:textColor="@color/neon_pink_soft"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Clock + settings -->
    <LinearLayout
        android:id="@+id/clockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="00:00"
            android:textColor="@color/neon_pink"
            android:textSize="19sp"
            android:shadowColor="#FFFF2BD6"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/settingsBtn"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_neon_circle_btn"
        android:contentDescription="Settings"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="@id/clockBlock"
        app:layout_constraintTop_toBottomOf="@id/clockBlock"/>

    <!-- ═════════════ AVATAR STAGE (fills the space between header and waveform) ═════════════ -->
    <com.myra.assistant.ui.avatar.AvatarStageView
        android:id="@+id/avatarStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/waveformView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taglineText"
        app:layout_constraintWidth_max="460dp"/>

    <!-- crown resting on top of the neon ring (bias ≈ ring top as a fraction of the stage) -->
    <ImageView
        android:id="@+id/crownStage"
        android:layout_width="44dp"
        android:layout_height="33dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crown"
        app:layout_constraintBottom_toBottomOf="@id/avatarStage"
        app:layout_constraintEnd_toEndOf="@id/avatarStage"
        app:layout_constraintStart_toStartOf="@id/avatarStage"
        app:layout_constraintTop_toTopOf="@id/avatarStage"
        app:layout_constraintVertical_bias="0.07"/>

    <!-- ═════════════ WAVEFORM ═════════════ -->
    <com.myra.assistant.ui.avatar.NeonWaveformView
        android:id="@+id/waveformView"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/statusPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Chat history (toggled with the chat button); floats above the status panel -->
    <FrameLayout
        android:id="@+id/chatOverlay"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_status_panel"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/statusPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadeScrollbars="true"
            android:padding="10dp"
            android:scrollbars="none"/>
    </FrameLayout>

    <!-- ═════════════ STATUS PANEL ═════════════ -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_status_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/navWrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="MYRA"
                android:textColor="@color/neon_pink"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:maxWidth="190dp"
                android:text="@string/system_ready"
                android:textColor="@color/neon_pink"
                android:textSize="15sp"
                android:shadowColor="#FFFF2BD6"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_panel_divider"/>

        <LinearLayout
            android:id="@+id/panelMessageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/panelMessageIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_neon"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/panelMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/neon_white"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═════════════ FIXED 3D CARD: CHAT · VOICE (big) · WALLPAPER (settings = top gear icon) ═════════════ -->
    <FrameLayout
        android:id="@+id/navWrap"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_nav_glass"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_btn_3d"
                android:clickable="true"
                android:contentDescription="Chat"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chat_neon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFFF2BD6"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:text="Chat"
                    android:textColor="@color/neon_white"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- room for the big centre VOICE button -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"/>

            <LinearLayout
                android:id="@+id/navWallpaper"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_btn_3d"
                android:clickable="true"
                android:contentDescription="Live wallpapers"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wallpaper"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFFF2BD6"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"
                    android:text="Wallpaper"
                    android:textColor="@color/neon_white"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- big VOICE button (ids unchanged: micGroup / micGlow / micButton) -->
        <FrameLayout
            android:id="@+id/micGroup"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:elevation="14dp">

            <View
                android:id="@+id/micGlow"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:alpha="0.45"
                android:background="@drawable/bg_mic_glow_neon"/>

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button_neon"
                android:contentDescription="Voice"
                android:elevation="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic_neon_off"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="9dp"
            android:elevation="16dp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#FFFF2BD6"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="Voice"
            android:textColor="@color/neon_white"
            android:textSize="12sp"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
