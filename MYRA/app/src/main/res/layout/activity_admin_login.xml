<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12001A">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/myra_bg_scene"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chat_scrim"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_3d"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#FFFF2BD6"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="14"
                    android:text="🔐 Admin Login"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="Sirf authorized administrator"
                    android:textColor="#FFFFB8F2"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/adminEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Admin email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FFB98CC4"
                    android:textSize="16sp"/>

                <EditText
                    android:id="@+id/adminPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FFB98CC4"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/adminLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFF8FA8"
                    android:textSize="14sp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/adminLoginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_save_button"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="LOGIN"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"/>

                <ProgressBar
                    android:id="@+id/adminLoginProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="#FFFF4FD8"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
