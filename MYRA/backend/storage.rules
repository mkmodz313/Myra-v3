rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'umarmalang496@gmail.com';
    }

    match /wallpapers/{allPaths=**} {
      // Files are fetched through their download URLs (thumbnails first, video only when needed).
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.size < 150 * 1024 * 1024
                            && (request.resource.contentType.matches('video/.*')
                                || request.resource.contentType.matches('image/.*'));
      allow delete: if isAdmin();
    }
  }
}
