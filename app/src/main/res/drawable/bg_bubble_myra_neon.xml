    <item android:top="2dp" android:bottom="30dp" android:left="4dp" android:right="4dp"><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF"/>
        <corners android:topLeftRadius="5dp" android:topRightRadius="20dp" android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp"/></shape></item>
