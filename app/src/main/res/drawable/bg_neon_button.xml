<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item android:top="-3dp" android:bottom="-3dp" android:left="-3dp" android:right="-3dp">
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="#38FF2BD6"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#FFFF4FD8" android:endColor="#FFB01E9E"/>
                    <stroke android:width="1.5dp" android:color="#FFFFE0FA"/>
                    <corners android:radius="26dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
