<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- extrusion / drop shadow -->
    <item android:top="8dp"><shape android:shape="rectangle"><solid android:color="#CC000000"/><corners android:radius="24dp"/></shape></item>
    <!-- body -->
    <item android:bottom="6dp"><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#F0701040" android:endColor="#F02A0618"/>
        <stroke android:width="1dp" android:color="#66FF9CEB"/>
        <corners android:radius="24dp"/></shape></item>
    <!-- top gloss -->
    <item android:top="2dp" android:bottom="70dp" android:left="3dp" android:right="3dp"><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF"/>
        <corners android:radius="22dp"/></shape></item>
</layer-list>
